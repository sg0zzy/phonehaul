{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhoneHaul",
  "version": "0.1.0",
  "identifier": "org.phonehaul.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "npm run build:sidecar && npm run frontend:dev",
      "wait": false
    },
    "beforeBuildCommand": "npm run frontend:build && npm run build:sidecar && npm run stage:appimage-libraries",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../frontend-dist"
  },
  "app": {
    "windows": [
      {
        "title": "PhoneHaul",
        "width": 580,
        "height": 763,
        "minWidth": 284,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "category": "Utility",
    "shortDescription": "Local network phone file transfer",
    "resources": ["resources/phonehaul-server*"],
    "linux": {
      "appimage": {
        "files": {
          "/usr/lib/libldap.so.2": "bundle-support/libldap.so.2"
        }
      }
    }
  }
}
