# Git exclusions required by the pinned dev-standards ARTIFACTS.md policy
# (see DEVELOPMENT_STANDARDS.md). `/local_artifacts/` is root-anchored because
# it is the managed artifact root; the other patterns apply at any depth.
/local_artifacts/
node_modules/
dist/
__pycache__/
target/
.build-state/
receiver/.build/
*.phonehaul-partial
.DS_Store
android/.gradle/
android/local.properties
android/app/build/
android/build/
desktop/node_modules/
desktop/frontend-dist/
desktop/src-tauri/target/
desktop/src-tauri/resources/phonehaul-server*
desktop/src-tauri/gen/
*.jks
*.keystore
desktop/src-tauri/bundle-support/
.zed/
# CI staging and release transport (local workflows own the implementation)
/ci-output/
/release-assets/
/assets-release/
/SHA256SUMS.txt
/RELEASE_NOTES.md

# Per-machine state and signing material
settings.json
*.p12
*.pfx
*.key
*.pem
/.phonehaul-local-counter-initialized
