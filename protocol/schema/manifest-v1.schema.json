{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phonehaul.local/schema/manifest-v1.schema.json",
  "title": "PhoneHaul transfer manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "operation", "items"],
  "properties": {
    "protocol": { "const": 1 },
    "operation": { "enum": ["copy", "move"] },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "relativePath", "size", "sha256"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,100}$" },
              "type": { "const": "file" },
              "relativePath": { "type": "string", "minLength": 1 },
              "size": { "type": "integer", "minimum": 0 },
              "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
              "modified": { "type": "integer" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "relativePath"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,100}$" },
              "type": { "const": "directory" },
              "relativePath": { "type": "string", "minLength": 1 }
            }
          }
        ]
      }
    }
  }
}
